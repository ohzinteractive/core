{
  // Change this to match your project
  "include": ["**/*"],
  // Keeps the test harness out of declaration generation. Note that
  // generate-types is independently broken at v13.3.0: it emits types/src
  // and types/tasks rather than the flat types/ layout package.json
  // publishes, and it fails on @types/three resolution. Unrelated to this.
  "exclude": ["node_modules", "tests", "vitest.config.ts"],
  "compilerOptions": {
    // Tells TypeScript to read JS files, as
    // normally they are ignored as source files
    "allowJs": false,
    "strict": false,
    // Generate d.ts files
    "declaration": true,
    // This compiler run should
    // only output d.ts files
    "emitDeclarationOnly": true,
    // Types should go into this directory.
    // Removing this would place the .d.ts files
    // next to the .js files
    "lib": ["es2021", "dom"],
    "target": "es2021",
    "outDir": "types",
    "noImplicitAny": true,
    "module": "esnext",
    "types": ["three", "@webgpu/types"],
    "paths": {
      "three/webgpu": ["../node_modules/@types/three/build/three.webgpu.d.ts"],
      "three/tsl": ["../node_modules/@types/three/build/three.tsl.d.ts"],
    }
  }
}
